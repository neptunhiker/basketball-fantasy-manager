# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5433/crossover

# Production only (set as Fly secrets, not here):
# ALLOWED_HOSTS=crossover.example.com
# RESEND_API_KEY=re_xxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=Crossover Manager <noreply@example.com>
