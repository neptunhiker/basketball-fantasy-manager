# Development environment template. Copy to .env and replace placeholders.
# Never commit .env or put real credentials in this file.
DJANGO_SETTINGS_MODULE=config.settings.dev
ENVIRONMENT=development
ALLOW_DEMO_DATA=true
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5433/crossover
RAPID_API_KEY=replace-with-your-rapidapi-key

# Production only (set as Fly secrets, not here):
# ALLOWED_HOSTS=crossover.example.com
# RESEND_API_KEY=re_xxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=Crossover Manager <noreply@example.com>

# Staging uses the production settings module with an explicit staging identity:
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ENVIRONMENT=staging
# ALLOW_DEMO_DATA=true

# Production should keep fabricated data disabled:
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ENVIRONMENT=production
# ALLOW_DEMO_DATA=false
