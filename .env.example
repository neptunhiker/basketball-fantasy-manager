# Development environment template. Copy to .env and replace placeholders.
# Never commit .env or put real credentials in this file.
DJANGO_SETTINGS_MODULE=config.settings.dev
ENVIRONMENT=development
ALLOW_DEMO_DATA=true
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5433/crossover
RAPID_API_KEY=replace-with-your-rapidapi-key

# Production only (set as Fly secrets, not here):
# ALLOWED_HOSTS=crossover.example.com
# RESEND_API_KEY=re_xxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=Crossover Manager <noreply@example.com>
# basketball.de login for the daily 12:15 import; leave unset to skip it:
# BBDE_USERNAME=your-basketball-de-username
# BBDE_PASSWORD=your-basketball-de-password
# RotoWire news shares RAPID_API_KEY's monthly requests; switch it off on staging:
# ROTOWIRE_ENABLED=false
# The NBA schedule loads only in production unless switched on here; copy it
# from production instead (see the README):
# NBA_SCHEDULE_ENABLED=true

# Staging uses the production settings module with an explicit staging identity:
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ENVIRONMENT=staging
# ALLOW_DEMO_DATA=true

# Production should keep fabricated data disabled:
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ENVIRONMENT=production
# ALLOW_DEMO_DATA=false

# Required by docker-compose.deploy.yml for staging/production deployments:
# APP_PORT=8000
# POSTGRES_DB=crossover
# POSTGRES_USER=crossover
# POSTGRES_PASSWORD=replace-with-a-strong-password
